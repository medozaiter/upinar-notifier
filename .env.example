# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Encryption key for securing student credentials in SQLite (Fernet AES-256)
# If left empty, the bot generates a secure key automatically on startup and saves it here.
ENCRYPTION_KEY=

# Periodic scan interval in minutes:
# Examples:
# 1440 = Once every 24 hours (Daily comparison)
# 720  = Every 12 hours
# 360  = Every 6 hours
# 60   = Every 1 hour
# 30   = Every 30 minutes (recommended)
CHECK_INTERVAL_MINUTES=30

# Optional custom database path
DATABASE_PATH=data/upinar.sqlite3
